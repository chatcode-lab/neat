# Static files are served by Cloudflare without running the Worker, and these
# headers apply to them only. Built files have a content hash in their names,
# so browsers keep them for a year without checking back; the icons keep
# their names, so they are checked daily.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-16x16.png
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/android-chrome-192x192.png
  Cache-Control: public, max-age=86400
/android-chrome-512x512.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
