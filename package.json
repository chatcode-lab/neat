{
  "name": "neat-link",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB -c wrangler.jsonc --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB -c wrangler.jsonc --env production --remote",
    "legacy:export": "tsx scripts/legacy-export.ts",
    "legacy:import:local": "npm run legacy:export -- ../neat-legacy/db/neat.sqlite .wrangler/legacy && wrangler d1 execute DB --local --file .wrangler/legacy/legacy.sql && sh .wrangler/legacy/legacy-images.sh --local",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production npm run build && wrangler deploy",
    "secret:staging": "wrangler secret put -c wrangler.jsonc --env staging",
    "secret:production": "wrangler secret put -c wrangler.jsonc --env production",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.7.7",
    "isbot": "^5.1.36",
    "lucide-react": "^1.56.0",
    "markdown-it": "^14.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "simple-icons": "^15.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
